<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Cuentitas.App.Dialogs.CategoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:Cuentitas.App.Controls"
    PrimaryButtonText="Guardar"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClick"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
        <StackPanel Width="540" Spacing="16">
            <TextBox x:Name="NameBox" Header="Nombre" PlaceholderText="Ej.: Gimnasio" MaxLength="40" />

            <StackPanel x:Name="NecessityPanel" Spacing="4">
                <TextBlock Text="Por defecto, los gastos de esta categoría son…" />
                <toolkit:Segmented x:Name="NecessityBox">
                    <toolkit:SegmentedItem Content="Necesarios" />
                    <toolkit:SegmentedItem Content="Prescindibles" />
                </toolkit:Segmented>
                <TextBlock Style="{StaticResource LabelStyle}" TextWrapping="Wrap"
                           Text="Igual podés cambiarlo en cada gasto. Ej.: Supermercado es necesario, Delivery es prescindible." />
            </StackPanel>

            <controls:IconColorPicker x:Name="Picker" />

            <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
