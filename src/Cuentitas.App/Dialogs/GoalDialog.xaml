<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Cuentitas.App.Dialogs.GoalDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:Cuentitas.App.Controls"
    PrimaryButtonText="Guardar"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClick"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
        <StackPanel Width="620" Spacing="16">
            <StackPanel x:Name="TemplatesPanel" Spacing="6">
                <TextBlock Text="Ideas" Style="{StaticResource LabelStyle}" />
                <ItemsControl x:Name="TemplatesList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <toolkit:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NameBox" Header="Nombre" PlaceholderText="Ej.: Vacaciones en Bariloche" MaxLength="60" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Moneda" />
                    <toolkit:Segmented x:Name="CurrencyBox" SelectionChanged="OnCurrencyChanged">
                        <toolkit:SegmentedItem Content="$ Pesos" />
                        <toolkit:SegmentedItem Content="US$ Dólares" />
                    </toolkit:Segmented>
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="¿Cuánto querés juntar?" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TargetSymbol" Text="$" VerticalAlignment="Center" FontSize="18" />
                        <TextBox x:Name="TargetBox" Grid.Column="1" PlaceholderText="0" InputScope="Number" FontSize="18" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <CheckBox x:Name="DateCheck" Content="Quiero llegar para una fecha" Checked="OnDateChecked" Unchecked="OnDateChecked" />
                    <CalendarDatePicker x:Name="DateBox" IsEnabled="False" HorizontalAlignment="Stretch" FirstDayOfWeek="Monday"
                                        DateFormat="{}{day.integer} {month.abbreviated} {year.full}" />
                </StackPanel>
            </Grid>

            <StackPanel Spacing="6">
                <TextBlock Text="¿Cómo medimos lo que llevás juntado?" />
                <RadioButtons x:Name="TrackingBox" SelectionChanged="OnTrackingChanged">
                    <x:String>Con aportes que voy registrando (la plata puede estar en cualquier cuenta)</x:String>
                    <x:String>Con el saldo de una cuenta dedicada a esta meta</x:String>
                </RadioButtons>
                <ComboBox x:Name="AccountBox" HorizontalAlignment="Stretch" PlaceholderText="Elegí la cuenta"
                          ItemTemplate="{StaticResource AccountComboTemplate}" Visibility="Collapsed" />
                <TextBlock x:Name="AccountHint" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" Visibility="Collapsed"
                           Text="Ideal para «Dólares ahorro» o un plazo fijo: el progreso es el saldo de esa cuenta." />
            </StackPanel>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Aporte mensual planificado (opcional)" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PlannedSymbol" Text="$" VerticalAlignment="Center" FontSize="16" />
                        <TextBox x:Name="PlannedBox" Grid.Column="1" PlaceholderText="Vacío = tu ahorro promedio" InputScope="Number" />
                    </Grid>
                </StackPanel>
                <ToggleSwitch x:Name="InflationToggle" Grid.Column="1" Header="Ajustar el objetivo por inflación"
                              OnContent="Sí (recomendado en pesos)" OffContent="No" IsOn="True" />
            </Grid>

            <controls:IconColorPicker x:Name="Picker" />

            <TextBox x:Name="NoteBox" Header="Nota (opcional)" MaxLength="500" />

            <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
