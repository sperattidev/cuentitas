<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Cuentitas.App.Dialogs.TransactionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Cuentitas.App.ViewModels"
    xmlns:controls="using:Cuentitas.App.Controls"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    PrimaryButtonText="Guardar"
    SecondaryButtonText="Guardar y cargar otro"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClick"
    SecondaryButtonClick="OnSecondaryClick"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
        <StackPanel Width="620" Spacing="16">

            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                     Message="{x:Bind ViewModel.InfoText, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.InfoVisibility, Mode=OneWay}" />

            <toolkit:Segmented x:Name="TypeSelector" HorizontalAlignment="Stretch"
                               IsEnabled="{x:Bind ViewModel.CanChangeType, Mode=OneWay}"
                               SelectedIndex="{x:Bind ViewModel.TypeIndex, Mode=TwoWay}">
                <toolkit:SegmentedItem Content="Gasto" />
                <toolkit:SegmentedItem Content="Ingreso" />
                <toolkit:SegmentedItem Content="Transferencia" />
            </toolkit:Segmented>

            <!-- Monto(s) -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.AmountLabel, Mode=OneWay}" Style="{StaticResource LabelStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.CurrencySymbol, Mode=OneWay}" VerticalAlignment="Center"
                                   FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="AmountBox" Grid.Column="1" FontSize="28" PlaceholderText="0"
                                 InputScope="Number" KeyDown="OnAmountKeyDown"
                                 Text="{x:Bind ViewModel.AmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4" Width="200">
                    <TextBlock Text="Fecha" Style="{StaticResource LabelStyle}" />
                    <CalendarDatePicker x:Name="DatePicker" HorizontalAlignment="Stretch" Height="52"
                                        FirstDayOfWeek="Monday" DateFormat="{}{day.integer} {month.abbreviated} {year.full}"
                                        DateChanged="OnDateChanged" />
                </StackPanel>
            </Grid>

            <!-- Cuenta(s) -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.AccountLabel, Mode=OneWay}" Style="{StaticResource LabelStyle}" />
                    <ComboBox x:Name="AccountBox" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.Accounts}"
                              SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=OneWay}"
                              ItemTemplate="{StaticResource AccountComboTemplate}"
                              SelectionChanged="OnAccountChanged" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4" Visibility="{x:Bind ViewModel.InstallmentsVisibility, Mode=OneWay}">
                    <TextBlock Text="Cuotas" Style="{StaticResource LabelStyle}" />
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.InstallmentOptions}"
                              SelectedIndex="{x:Bind ViewModel.InstallmentIndex, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4" Visibility="{x:Bind ViewModel.TransferVisibility, Mode=OneWay}">
                    <TextBlock Text="Hacia" Style="{StaticResource LabelStyle}" />
                    <ComboBox x:Name="ToAccountBox" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.TargetAccounts}"
                              SelectedItem="{x:Bind ViewModel.SelectedToAccount, Mode=OneWay}"
                              ItemTemplate="{StaticResource AccountComboTemplate}"
                              SelectionChanged="OnToAccountChanged" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{x:Bind ViewModel.InstallmentHint, Mode=OneWay}" Style="{StaticResource LabelStyle}"
                       Visibility="{x:Bind ViewModel.InstallmentHintVisibility, Mode=OneWay}"
                       TextWrapping="Wrap" Margin="0,-8,0,0" />

            <!-- Compra / venta de dólares -->
            <Border Style="{StaticResource CardStyle}" Padding="16"
                    Background="{ThemeResource BrandSoftBrush}"
                    Visibility="{x:Bind ViewModel.ToAmountVisibility, Mode=OneWay}">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.ToAmountLabel, Mode=OneWay}" Style="{StaticResource LabelStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.ToCurrencySymbol, Mode=OneWay}" VerticalAlignment="Center" FontSize="20" />
                                <TextBox Grid.Column="1" FontSize="20" PlaceholderText="0" InputScope="Number"
                                         Text="{x:Bind ViewModel.ToAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Tipo de dólar" Style="{StaticResource LabelStyle}" />
                            <ComboBox HorizontalAlignment="Stretch" Height="44"
                                      ItemsSource="{x:Bind ViewModel.DollarTypeOptions}"
                                      SelectedIndex="{x:Bind ViewModel.DollarTypeIndex, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.RateText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                </StackPanel>
            </Border>

            <!-- Categorías: grilla para elegir con un clic -->
            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.CategoryVisibility, Mode=OneWay}">
                <TextBlock Text="Categoría" Style="{StaticResource LabelStyle}" />
                <GridView x:Name="CategoryGrid" MaxHeight="236" SelectionMode="Single"
                          ItemsSource="{x:Bind ViewModel.Categories}"
                          SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=OneWay}"
                          SelectionChanged="OnCategoryChanged">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryOption">
                            <StackPanel Width="104" Height="72" Spacing="4" Padding="4,8,4,4">
                                <controls:IconBadge IconKey="{x:Bind IconKey}" Color="{x:Bind Color}" Size="32" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind Name}" FontSize="11" TextAlignment="Center" MaxLines="2" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <!-- Necesario / prescindible -->
            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.NecessityVisibility, Mode=OneWay}">
                <TextBlock Text="¿Este gasto era necesario?" Style="{StaticResource LabelStyle}" />
                <toolkit:Segmented SelectedIndex="{x:Bind ViewModel.NecessityIndex, Mode=TwoWay}">
                    <toolkit:SegmentedItem Content="Necesario" />
                    <toolkit:SegmentedItem Content="Prescindible" />
                </toolkit:Segmented>
                <TextBlock Style="{StaticResource LabelStyle}" TextWrapping="Wrap"
                           Text="Los gastos prescindibles se usan para calcular cuánto podrías ahorrar para tus metas." />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Nota (opcional)" Style="{StaticResource LabelStyle}" />
                <TextBox PlaceholderText="Ej.: pizza con amigos" MaxLength="500"
                         Text="{x:Bind ViewModel.Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <InfoBar IsOpen="True" IsClosable="False" Severity="Error"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
