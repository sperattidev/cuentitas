<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Cuentitas.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cuentitas">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnNewTransactionAccelerator" />
            <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="OnLockAccelerator" />
        </Grid.KeyboardAccelerators>

        <!-- Barra de título personalizada (arrastrable) -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Width="18" Height="18" Source="ms-appx:///Assets/AppIcon.png" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Cuentitas" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Auto"
            CompactModeThresholdWidth="0"
            ExpandedModeThresholdWidth="1000"
            OpenPaneLength="240"
            SelectionChanged="OnNavSelectionChanged">

            <NavigationView.PaneCustomContent>
                <Button x:Name="NewButton" Margin="12,8,12,8" HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}" Click="OnNewTransactionClick"
                        ToolTipService.ToolTip="Nuevo movimiento (Ctrl+N)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Add" />
                        <TextBlock x:Name="NewButtonText" Text="Nuevo movimiento" />
                    </StackPanel>
                </Button>
            </NavigationView.PaneCustomContent>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Inicio" Tag="home" Icon="Home" />
                <NavigationViewItem Content="Movimientos" Tag="transactions" Icon="List" />
                <NavigationViewItem x:Name="BillsItem" Content="Vencimientos" Tag="bills" Icon="Calendar">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="BillsBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Metas" Tag="goals">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Presupuestos" Tag="budgets">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EF;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Reportes" Tag="reports">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Cuentas" Tag="accounts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE825;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Categorías" Tag="categories" Icon="Tag" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Pantallas completas sin menú (bienvenida) -->
        <Frame x:Name="FullFrame" Grid.Row="1" Visibility="Collapsed" />

        <!-- Bloqueo (PIN / Windows Hello). Tapa todo mientras está visible. -->
        <Grid x:Name="LockOverlay" Grid.Row="1" Visibility="Collapsed"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <StackPanel Width="340" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Width="64" Height="64" Source="ms-appx:///Assets/AppIcon.png" />
                <TextBlock Text="Cuentitas está bloqueada" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <PasswordBox x:Name="PinBox" PlaceholderText="Ingresá tu PIN" InputScope="NumericPin" MaxLength="8"
                             KeyDown="OnPinKeyDown" HorizontalAlignment="Stretch" />
                <Button x:Name="UnlockButton" Content="Desbloquear" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch" Click="OnUnlockClick" />
                <Button x:Name="HelloButton" HorizontalAlignment="Stretch" Click="OnHelloClick" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE928;" FontSize="16" />
                        <TextBlock Text="Usar Windows Hello" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="LockError" Foreground="{ThemeResource ExpenseBrush}" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
