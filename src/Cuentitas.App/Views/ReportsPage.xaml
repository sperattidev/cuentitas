<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cuentitas.App.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Cuentitas.App.ViewModels"
    xmlns:controls="using:Cuentitas.App.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="16">
            <Grid Margin="0,16,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Reportes" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Cómo vienen tus finanzas mes a mes (en pesos)." Style="{StaticResource LabelStyle}" />
                </StackPanel>
                <toolkit:Segmented Grid.Column="1" VerticalAlignment="Center" SelectedIndex="{x:Bind ViewModel.RangeIndex, Mode=TwoWay}">
                    <toolkit:SegmentedItem Content="6 meses" />
                    <toolkit:SegmentedItem Content="12 meses" />
                </toolkit:Segmented>
                <Button Grid.Column="2" VerticalAlignment="Center" Click="OnExportClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE896;" FontSize="14" />
                        <TextBlock Text="Exportar a Excel" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Indicadores -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Ahorro promedio por mes" Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.AvgSavingsText, Mode=OneWay}" Style="{StaticResource AmountLargeStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.SavingsRateText, Mode=OneWay}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Gasto prescindible" Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.OptionalShareText, Mode=OneWay}" Foreground="{ThemeResource OptionalBrush}" Style="{StaticResource AmountLargeStyle}" />
                        <TextBlock Text="de todo lo que gastaste" Style="{StaticResource LabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Mejor mes" Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.BestMonthText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Variación de tu patrimonio" Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.NetWorthChangeText, Mode=OneWay}" Style="{StaticResource AmountLargeStyle}" />
                        <TextBlock Text="en pesos, en el período" Style="{StaticResource LabelStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Ingresos vs gastos -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="Ingresos y gastos" Style="{StaticResource CardTitleStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{ThemeResource IncomeBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Ingresos" Style="{StaticResource LabelStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{ThemeResource ExpenseBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Gastos" Style="{StaticResource LabelStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <controls:BarChart Height="240" Data="{x:Bind ViewModel.IncomeExpense, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="Necesario vs prescindible" Style="{StaticResource CardTitleStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{ThemeResource BrandBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Necesarios" Style="{StaticResource LabelStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{ThemeResource OptionalBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Prescindibles" Style="{StaticResource LabelStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <controls:BarChart Height="220" Data="{x:Bind ViewModel.Necessity, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Tu patrimonio en pesos (a fin de cada mes)" Style="{StaticResource CardTitleStyle}" />
                        <controls:LineChart Height="220" Points="{x:Bind ViewModel.NetWorth, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Mes seleccionado: dona + comparación -->
            <Grid ColumnSpacing="12">
                <TextBlock Text="Detalle del mes" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                    <Button Command="{x:Bind ViewModel.PreviousMonthCommand}"><FontIcon Glyph="&#xE76B;" FontSize="14" /></Button>
                    <Border MinWidth="160" Padding="12,5" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <TextBlock Text="{x:Bind ViewModel.MonthTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                    </Border>
                    <Button Command="{x:Bind ViewModel.NextMonthCommand}" IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"><FontIcon Glyph="&#xE76C;" FontSize="14" /></Button>
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Gastos por categoría" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Sin gastos en este mes." Style="{StaticResource LabelStyle}" Visibility="{x:Bind ViewModel.DonutEmptyVisibility, Mode=OneWay}" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:DonutChart Height="200" Slices="{x:Bind ViewModel.Slices, Mode=OneWay}" CenterText="{x:Bind ViewModel.DonutCenter, Mode=OneWay}" />
                            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.Legend}" VerticalAlignment="Center">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LegendRow">
                                        <Grid ColumnSpacing="8" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>
                                            <controls:IconBadge IconKey="{x:Bind IconKey}" Color="{x:Bind Color}" Size="24" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind AmountText}" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind ShareText}" VerticalAlignment="Center" Style="{StaticResource LabelStyle}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Comparado con el mes anterior" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ComparisonTitle, Mode=OneWay}" Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ComparisonSummary, Mode=OneWay}" Foreground="{x:Bind ViewModel.ComparisonBrush, Mode=OneWay}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Changes}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChangeRow">
                                    <Grid ColumnSpacing="10" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <controls:IconBadge IconKey="{x:Bind IconKey}" Color="{x:Bind Color}" Size="28" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind PreviousText}" Style="{StaticResource LabelStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind CurrentText}" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ChangeText}" Foreground="{x:Bind ChangeBrush}" HorizontalAlignment="Right" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind RealText}" Style="{StaticResource LabelStyle}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
