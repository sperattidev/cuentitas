<?xml version="1.0" encoding="utf-8"?>
<!--
  Sistema visual de Cuentitas. Documentado en docs/DISENO.md.
  Regla: las páginas usan ESTOS recursos (no colores sueltos) para que claro/oscuro funcionen solos.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Acento de marca (teal) aplicado a todos los controles del sistema -->
            <Color x:Key="SystemAccentColor">#0F9D8A</Color>
            <Color x:Key="SystemAccentColorLight1">#22B3A0</Color>
            <Color x:Key="SystemAccentColorLight2">#4CC7B6</Color>
            <Color x:Key="SystemAccentColorLight3">#86DDD1</Color>
            <Color x:Key="SystemAccentColorDark1">#0B8475</Color>
            <Color x:Key="SystemAccentColorDark2">#086B5F</Color>
            <Color x:Key="SystemAccentColorDark3">#05524A</Color>

            <SolidColorBrush x:Key="IncomeBrush" Color="#138A4B" />
            <SolidColorBrush x:Key="ExpenseBrush" Color="#C8372D" />
            <SolidColorBrush x:Key="WarningBrush" Color="#B26A00" />
            <SolidColorBrush x:Key="OptionalBrush" Color="#B26A00" />
            <SolidColorBrush x:Key="IncomeSoftBrush" Color="#1A138A4B" />
            <SolidColorBrush x:Key="ExpenseSoftBrush" Color="#1AC8372D" />
            <SolidColorBrush x:Key="OptionalSoftBrush" Color="#1FB26A00" />
            <SolidColorBrush x:Key="BrandSoftBrush" Color="#1A0F9D8A" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9E000000" />
            <SolidColorBrush x:Key="BrandBrush" Color="#0F9D8A" />
            <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#0F9D8A" />
                <GradientStop Offset="1" Color="#0B6E8F" />
            </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#2BB8A4</Color>
            <Color x:Key="SystemAccentColorLight1">#46C8B5</Color>
            <Color x:Key="SystemAccentColorLight2">#6FD6C7</Color>
            <Color x:Key="SystemAccentColorLight3">#9AE4D9</Color>
            <Color x:Key="SystemAccentColorDark1">#159C8A</Color>
            <Color x:Key="SystemAccentColorDark2">#0F7F71</Color>
            <Color x:Key="SystemAccentColorDark3">#0A6258</Color>

            <SolidColorBrush x:Key="IncomeBrush" Color="#4CD088" />
            <SolidColorBrush x:Key="ExpenseBrush" Color="#FF7A6E" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F2B54A" />
            <SolidColorBrush x:Key="OptionalBrush" Color="#F2B54A" />
            <SolidColorBrush x:Key="IncomeSoftBrush" Color="#264CD088" />
            <SolidColorBrush x:Key="ExpenseSoftBrush" Color="#26FF7A6E" />
            <SolidColorBrush x:Key="OptionalSoftBrush" Color="#26F2B54A" />
            <SolidColorBrush x:Key="BrandSoftBrush" Color="#262BB8A4" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C5FFFFFF" />
            <SolidColorBrush x:Key="BrandBrush" Color="#2BB8A4" />
            <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#11806F" />
                <GradientStop Offset="1" Color="#0D4F6B" />
            </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="IncomeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ExpenseBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OptionalBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="IncomeSoftBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ExpenseSoftBrush" Color="Transparent" />
            <SolidColorBrush x:Key="OptionalSoftBrush" Color="Transparent" />
            <SolidColorBrush x:Key="BrandSoftBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BrandBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="HeroBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Espaciado (múltiplos de 4) -->
    <x:Double x:Key="PageMaxWidth">1240</x:Double>
    <Thickness x:Key="PagePadding">32,8,32,32</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <x:Double x:Key="SectionSpacing">16</x:Double>

    <!-- Tarjeta base -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <!-- Tipografía -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontSize" Value="28" />
    </Style>
    <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="LabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <!-- Montos: Segoe UI Variable tiene cifras tabulares, las columnas alinean -->
    <Style x:Key="AmountHeroStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="AmountLargeStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="AmountStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- Etiqueta chica (pill) -->
    <Style x:Key="PillStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
